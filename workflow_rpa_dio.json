    },
    {
      "parameters": {
        "jsCode": "const output = JSON.parse($input.first().json.stdout);\nreturn [{ json: output }];"
      },
      "id": "3",
      "name": "Parse JSON Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
